{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, s-maxage=86400" }
      ]
    },
    {
      "source": "/(list|settings|search|404.html|offline.html)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?type=index"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/api/sitemap?type=index"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/sitemap?type=static"
    },
    {
      "source": "/sitemap-movies.xml",
      "destination": "/api/sitemap?type=movies"
    },
    {
      "source": "/sitemap-tv.xml",
      "destination": "/api/sitemap?type=tv"
    },
    {
      "source": "/sitemap-anime.xml",
      "destination": "/api/sitemap?type=anime"
    },
    {
      "source": "/movie/:id(\\d+)",
      "destination": "/api/ssr?route=movie&id=:id"
    },
    {
      "source": "/tv/:id(\\d+)",
      "destination": "/api/ssr?route=tv&id=:id"
    },
    {
      "source": "/movie",
      "destination": "/movie.html"
    },
    {
      "source": "/tv",
      "destination": "/tv.html"
    },
    {
      "source": "/anime",
      "destination": "/anime.html"
    },
    {
      "source": "/search",
      "destination": "/search.html"
    },
    {
      "source": "/list",
      "destination": "/list.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/dmca",
      "destination": "/dmca.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/css/orc-styles.css",
      "destination": "/orc-styles.css"
    },
    {
      "source": "/js/orc-script.js",
      "destination": "/orc-script.js"
    },
    {
      "source": "/images/favicon.svg",
      "destination": "/favicon.svg"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }],
      "destination": "https://watch.osiris.rocks/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "osiris.rocks" }],
      "destination": "https://watch.osiris.rocks/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.osiris.rocks" }],
      "destination": "https://watch.osiris.rocks/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.watch.osiris.rocks" }],
      "destination": "https://watch.osiris.rocks/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/movie.html",
      "destination": "/movie",
      "permanent": true
    },
    {
      "source": "/tv.html",
      "destination": "/tv",
      "permanent": true
    },
    {
      "source": "/anime.html",
      "destination": "/anime",
      "permanent": true
    },
    {
      "source": "/search.html",
      "destination": "/search",
      "permanent": true
    },
    {
      "source": "/list.html",
      "destination": "/list",
      "permanent": true
    },
    {
      "source": "/settings.html",
      "destination": "/settings",
      "permanent": true
    },
    {
      "source": "/dmca.html",
      "destination": "/dmca",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ]
}
