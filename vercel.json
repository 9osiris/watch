{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/movie",
      "destination": "/movie.html"
    },
    {
      "source": "/tv",
      "destination": "/tv.html"
    },
    {
      "source": "/anime",
      "destination": "/anime.html"
    },
    {
      "source": "/search",
      "destination": "/search.html"
    },
    {
      "source": "/list",
      "destination": "/list.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/dmca",
      "destination": "/dmca.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/css/orc-styles.css",
      "destination": "/orc-styles.css"
    },
    {
      "source": "/js/orc-script.js",
      "destination": "/orc-script.js"
    },
    {
      "source": "/images/favicon.svg",
      "destination": "/favicon.svg"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "osiris.rocks" }],
      "destination": "https://watch.osiris.rocks/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.osiris.rocks" }],
      "destination": "https://watch.osiris.rocks/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/movie.html",
      "destination": "/movie",
      "permanent": true
    },
    {
      "source": "/tv.html",
      "destination": "/tv",
      "permanent": true
    },
    {
      "source": "/anime.html",
      "destination": "/anime",
      "permanent": true
    },
    {
      "source": "/search.html",
      "destination": "/search",
      "permanent": true
    },
    {
      "source": "/list.html",
      "destination": "/list",
      "permanent": true
    },
    {
      "source": "/settings.html",
      "destination": "/settings",
      "permanent": true
    },
    {
      "source": "/dmca.html",
      "destination": "/dmca",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ]
}
