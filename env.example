# Copy these variable NAMES into Vercel -> Project -> Settings -> Environment
# Variables (or into a local .env.local for `vercel dev`). Never commit real keys.

# Optional TMDB key for server integrations. The catalog client uses APP_CONFIG.
TMDB_KEY=

# AI discovery planning and reranking (Groq). Comma-separated server-side keys.
# GROQ_API_KEYS=gsk_xxx,gsk_yyy,gsk_zzz
GROQ_API_KEYS=

# A single key may be provided instead of the comma-separated list.
GROQ_API_KEY=

# Optional fallback keys, tried only after every primary key is exhausted.
GROQ_FALLBACK_KEYS=

# Default model for the two-stage AI discovery engine.
GROQ_MODEL=openai/gpt-oss-20b
